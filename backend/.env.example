# =============================================================================
# SipSetu — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp backend/.env.example backend/.env
#
# The app loads these with python-dotenv on startup.
# =============================================================================

# --- PostgreSQL connection string -------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Default (used if DATABASE_URL is not set): postgresql://postgres:postgres@localhost:5432/sipsetu
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/sipsetu

# --- JWT secret key (change in production!) ---------------------------------
# Used to sign auth tokens. Must be a long, random string.
# Default: sipsetu-dev-jwt-secret-change-in-production
# JWT_SECRET_KEY=your-random-secret-here

# --- Frontend URL (for CORS + email links) ----------------------------------
# Default: http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# --- Optional: SMTP credentials for sending emails --------------------------
# These are used for password reset OTPs and email verification.
# If not set, the app tries default SMTP settings (typically works only in dev).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
