[TEMPLATE]
# SipSetu backend environment template.
# Copy to .env and adjust for your environment.

# --- App ---
ENVIRONMENT=development              # development | staging | production
DEBUG=false
APP_NAME=SipSetu
APP_VERSION=1.0.0

# --- Security ---
JWT_SECRET_KEY=sipsetu-dev-jwt-secret-change-in-production

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipsetu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# --- Redis (rate limiting, Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@sipsetu.com

# --- Storage (local | s3 | minio) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=sipsetu-uploads
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOCAL_STORAGE_PATH=/tmp/sipsetu-uploads

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=200 per minute

# --- ML ranking ---
ML_MODEL_DIR=ml_artifacts
ML_MIN_TRAINING_ROWS=15
ML_MAX_ALPHA=0.8

# --- File uploads ---
MAX_FILE_SIZE_MB=10

# --- Monitoring & observability ---
METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | text
SENTRY_DSN=
# OpenTelemetry distributed tracing (false unless the deps + collector are available)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sipsetu
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLE_RATE=0.1

# --- Alerting (docker-compose observability profile) ---
# SLACK_WEBHOOK_URL=https://example.com/slack-webhook-placeholder
