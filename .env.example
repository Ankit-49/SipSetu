# SipSetu - Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipsetu

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# SMTP (leave unset to log emails to terminal in development)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true
# SMTP_FROM=noreply@sipsetu.com
