# =============================================================================
# SipSetu Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in the values

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=sipsetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# =============================================================================
# Backend Configuration
# =============================================================================
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_STRONG_SECRET

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://sipsetu.com

# Flask environment
FLASK_ENV=production
ENVIRONMENT=production

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM=noreply@sipsetu.com

# =============================================================================
# Security & Authentication
# =============================================================================
# Admin emails (comma-separated)
ADMIN_EMAILS=admin@sipsetu.com

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# =============================================================================
# Celery Workers
# =============================================================================
# Number of gunicorn workers (recommend: 2 * CPU cores + 1)
GUNICORN_WORKERS=4

# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=4

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Enable OpenTelemetry tracing
OTEL_ENABLED=true

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Grafana root URL
GRAFANA_ROOT_URL=http://localhost:3000

# Flower (Celery monitoring) basic auth
FLOWER_BASIC_AUTH=admin:CHANGE_ME

# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# Database Migrations
# =============================================================================
# Set to true to run migrations on container startup
ENABLE_MIGRATIONS=false
