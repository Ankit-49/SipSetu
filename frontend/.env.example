# Copy to .env and adjust. Vite exposes VITE_* vars to the client bundle.
# Backend API base URL (the axios client appends /api paths)
VITE_API_URL=http://localhost:5000/api

# Sentry error tracking (optional — leave blank to disable)
VITE_SENTRY_DSN=

# environment name reported to Sentry: development | staging | production
VITE_ENVIRONMENT=development

# app version used for Sentry release tagging (keep in sync with backend APP_VERSION)
VITE_APP_VERSION=1.0.0
